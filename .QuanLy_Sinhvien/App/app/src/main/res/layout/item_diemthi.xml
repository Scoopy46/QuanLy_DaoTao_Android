<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="100dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvItemMaSV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Mã SV: CD46.0001"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvItemMaMH"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mã MH: CSDL"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#2196F3" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemHoTen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Họ tên: Nguyễn Quang Anh"
        android:textSize="14sp"
        android:textColor="#333333"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/tvItemTenMon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Môn: Cơ sở dữ liệu"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginTop="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Điểm lần 1: "
            android:textSize="13sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvItemDiemLan1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="8.5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#4CAF50" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" | "
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Điểm lần 2: "
            android:textSize="13sp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/tvItemDiemLan2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="9.0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#4CAF50" />
    </LinearLayout>
</LinearLayout>

