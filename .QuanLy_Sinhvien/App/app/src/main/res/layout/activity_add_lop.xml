<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="THÊM LỚP MỚI"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2196F3"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Form Card -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/edtMaLop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mã lớp (VD: K59-CNTT)"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#2196F3" />

            <EditText
                android:id="@+id/edtTenLop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tên lớp đầy đủ"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#2196F3" />

            <EditText
                android:id="@+id/edtNienKhoa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Niên khóa (VD: 2024-2028)"
                android:padding="12dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#2196F3" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Thuộc Ngành:"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/spinnerNganh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:padding="12dp" />
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnHuy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hủy"
                android:backgroundTint="#9E9E9E"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnLuu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lưu"
                android:backgroundTint="#2196F3"
                android:layout_marginStart="8dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

