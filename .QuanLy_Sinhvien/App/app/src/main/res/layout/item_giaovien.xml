<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="?android:attr/selectableItemBackground"
    android:minHeight="80dp"
    android:layout_marginBottom="8dp"
    android:backgroundTint="#FFFFFF"
    android:elevation="2dp">

    <ImageView
        android:id="@+id/imgGiaoVienAvatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:background="#CCCCCC"
        android:contentDescription="Ảnh đại diện giáo viên" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvGiaoVienHoTen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Thạc sỹ. Nguyễn Văn A"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvGiaoVienKhoa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Khoa: Công nghệ thông tin"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>

