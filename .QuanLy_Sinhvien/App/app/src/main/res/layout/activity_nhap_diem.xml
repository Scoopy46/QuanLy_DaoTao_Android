<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E8D5E8"
    android:padding="16dp">

    <!-- Phần filter -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:elevation="2dp">

        <EditText
            android:id="@+id/edtFilterLop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Lọc theo lớp..."
            android:padding="8dp"
            android:backgroundTint="#9C27B0"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/edtFilterMaMH"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Lọc theo mã môn..."
            android:padding="8dp"
            android:backgroundTint="#9C27B0"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Nút tìm kiếm -->
    <Button
        android:id="@+id/btnTimKiem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tìm kiếm"
        android:backgroundTint="#2196F3"
        android:layout_marginBottom="16dp" />

    <!-- Tiêu đề danh sách -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Danh sách điểm thi"
        android:textStyle="bold"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <!-- ListView -->
    <ListView
        android:id="@+id/listViewDiemThi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="200dp"
        android:divider="#CCCCCC"
        android:dividerHeight="1dp"
        android:scrollbars="vertical" />

    <!-- Form nhập điểm -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="#FFFFFF"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nhập điểm thi"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/edtMaSV"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Mã sinh viên"
                android:padding="8dp"
                android:backgroundTint="#9C27B0"
                android:enabled="false"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnChonSinhVien"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn SV"
                android:backgroundTint="#2196F3" />
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/edtMaMH"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Mã môn học"
                android:padding="8dp"
                android:backgroundTint="#9C27B0"
                android:enabled="false"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnChonMonHoc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn MH"
                android:backgroundTint="#2196F3" />
        </LinearLayout>

        <EditText
            android:id="@+id/edtDiemLan1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Điểm lần 1"
            android:inputType="numberDecimal"
            android:padding="8dp"
            android:backgroundTint="#9C27B0"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edtDiemLan2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Điểm lần 2"
            android:inputType="numberDecimal"
            android:padding="8dp"
            android:backgroundTint="#9C27B0"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnLuuDiem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Lưu điểm"
                android:backgroundTint="#4CAF50"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnHuy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hủy"
                android:backgroundTint="#F44336"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

